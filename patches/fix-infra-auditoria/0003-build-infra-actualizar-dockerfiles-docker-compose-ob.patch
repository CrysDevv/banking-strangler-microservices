@@ -9,9 +9,13 @@ ARG NODE_IMAGE=node:20.18.1-alpine3.20
 # ---------- Etapa 1: dependencias completas (build) ----------
 FROM ${NODE_IMAGE} AS deps
 WORKDIR /build
-COPY package.json package-lock.json ./
+COPY package*.json ./
 RUN --mount=type=cache,target=/root/.npm \
-    npm ci --ignore-scripts --no-audit --no-fund
+    if [ -f package-lock.json ]; then \
+        npm ci --ignore-scripts --no-audit --no-fund; \
+    else \
+        npm install --ignore-scripts --no-audit --no-fund; \
+    fi
 
 # ---------- Etapa 2: compilación ----------
 FROM deps AS build
@@ -21,9 +25,13 @@ RUN npm run build
 # ---------- Etapa 3: solo dependencias de producción ----------
 FROM ${NODE_IMAGE} AS prod-deps
 WORKDIR /build
-COPY package.json package-lock.json ./
+COPY package*.json ./
 RUN --mount=type=cache,target=/root/.npm \
-    npm ci --omit=dev --ignore-scripts --no-audit --no-fund
+    if [ -f package-lock.json ]; then \
+        npm ci --omit=dev --ignore-scripts --no-audit --no-fund; \
+    else \
+        npm install --production --ignore-scripts --no-audit --no-fund; \
+    fi
 
 # ---------- Etapa 4: runtime ----------
