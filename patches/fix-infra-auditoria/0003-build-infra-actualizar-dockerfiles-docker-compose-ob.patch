@@ -1,7 +1,7 @@
 # syntax=docker/dockerfile:1.7
 # NestJS (Node.js 20) - multi-stage endurecido.
 # Contexto de build: raíz del microservicio (package.json, package-lock.json, src/).
-# Requiere: "npm run build" que genere dist/main.js y package-lock.json versionado.
+# Requiere: "npm run build" que genere dist/src/main.js. Se recomienda versionar package-lock.json.
