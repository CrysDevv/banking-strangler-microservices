@@ -0,0 +1,242 @@
+# banking-strangler-microservices - Fase 1
+# Los Dockerfiles endurecidos (UID 10001, multi-stage) se reutilizan desde ./docker/.
+# Los servicios de aplicacion se construyen cuando existe su codigo (Fases 2-4).
+name: banking-strangler-microservices
+
+x-hardening: &hardening
+  security_opt: ["no-new-privileges:true"]
+  cap_drop: ["ALL"]
+  read_only: true
+  tmpfs:
+    - /tmp:rw,nosuid,size=128m
+
+x-restart: &restart
+  restart: unless-stopped
+
+services:
+  # ------------------------------------------------------------------ Datos ----
+  mssql:
+    <<: *restart
+    image: mcr.microsoft.com/mssql/server:2022-latest
+    platform: linux/amd64
+    environment:
+      ACCEPT_EULA: "Y"
+      MSSQL_PID: "Developer"
+      MSSQL_SA_PASSWORD: "${MSSQL_SA_PASSWORD:-Banking#Strong2026}"
+      MSSQL_MEMORY_LIMIT_MB: "2048"
+    ports:
+      - "1433:1433"
+    volumes:
+      - mssql-data:/var/opt/mssql
+    healthcheck:
+      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P \"$${MSSQL_SA_PASSWORD}\" -C -b -Q 'SELECT 1' || exit 1"]
+      interval: 10s
+      timeout: 5s
+      retries: 20
+      start_period: 30s
+    networks: [banking-net]
+
+  init-db:
+    image: mcr.microsoft.com/mssql/server:2022-latest
+    platform: linux/amd64
+    restart: "no"
+    depends_on:
+      mssql:
+        condition: service_healthy
+    environment:
+      MSSQL_SA_PASSWORD: "${MSSQL_SA_PASSWORD:-Banking#Strong2026}"
+      APP_DB_PASSWORD: "${APP_DB_PASSWORD:-App#Banking2026}"
+    volumes:
+      - ./db/mssql:/scripts:ro
+    entrypoint: ["/bin/bash", "/scripts/init-db.sh"]
+    networks: [banking-net]
+
+  postgres:
+    <<: *restart
+    image: postgres:16-alpine
+    environment:
+      POSTGRES_DB: "${POSTGRES_DB:-audit_db}"
+      POSTGRES_USER: "${POSTGRES_USER:-audit_user}"
+      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:-Audit#Pg2026}"
+    ports:
+      - "5432:5432"
+    volumes:
+      - pg-data:/var/lib/postgresql/data
+      - ./db/postgres:/docker-entrypoint-initdb.d:ro
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
+      interval: 10s
+      timeout: 5s
+      retries: 10
+    networks: [banking-net]
+
+  redis:
+    <<: *restart
+    image: redis:7-alpine
+    command: ["redis-server", "--requirepass", "${REDIS_PASSWORD:-Redis#Cache2026}", "--appendonly", "yes"]
+    volumes:
+      - redis-data:/data
+    healthcheck:
+      test: ["CMD-SHELL", "redis-cli -a \"$${REDIS_PASSWORD:-Redis#Cache2026}\" --no-auth-warning ping | grep -q PONG"]
+      interval: 10s
+      timeout: 3s
+      retries: 10
+    environment:
+      REDIS_PASSWORD: "${REDIS_PASSWORD:-Redis#Cache2026}"
+    networks: [banking-net]
+
+  rabbitmq:
+    <<: *restart
+    image: rabbitmq:3.13-management-alpine
+    environment:
+      RABBITMQ_DEFAULT_USER: "${RABBITMQ_DEFAULT_USER:-banking}"
+      RABBITMQ_DEFAULT_PASS: "${RABBITMQ_DEFAULT_PASS:-Rabbit#Bus2026}"
+    ports:
+      - "5672:5672"
+      - "15672:15672"
+    volumes:
+      - rabbit-data:/var/lib/rabbitmq
+    healthcheck:
+      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
+      interval: 15s
+      timeout: 10s
+      retries: 10
+      start_period: 20s
+    networks: [banking-net]
+
+  # ------------------------------------------------------------ Aplicaciones ----
+  core-springboot:
+    <<: [*restart, *hardening]
+    build:
+      context: ./services/core-springboot
+      dockerfile: ../../docker/Dockerfile.java17
+    depends_on:
+      init-db:
+        condition: service_completed_successfully
+      rabbitmq:
+        condition: service_healthy
+    environment:
+      SERVER_PORT: "8080"
+      SPRING_DATASOURCE_URL: "jdbc:sqlserver://mssql:1433;databaseName=BankingCore;encrypt=true;trustServerCertificate=true"
+      SPRING_DATASOURCE_USERNAME: "banking_app"
+      SPRING_DATASOURCE_PASSWORD: "${APP_DB_PASSWORD:-App#Banking2026}"
+      SPRING_RABBITMQ_HOST: "rabbitmq"
+      SPRING_RABBITMQ_PORT: "5672"
+      SPRING_RABBITMQ_USERNAME: "${RABBITMQ_DEFAULT_USER:-banking}"
+      SPRING_RABBITMQ_PASSWORD: "${RABBITMQ_DEFAULT_PASS:-Rabbit#Bus2026}"
+      APP_JWT_SECRET: "${JWT_SECRET:-cambia-este-secreto-por-uno-de-al-menos-32-caracteres-aleatorios}"
+      OTEL_SERVICE_NAME: "core-springboot"
+      OTEL_EXPORTER_OTLP_ENDPOINT: "http://otel-collector:4317"
+      OTEL_EXPORTER_OTLP_PROTOCOL: "grpc"
+    expose: ["8080"]
+    networks: [banking-net]
+
+  bff-nestjs:
+    <<: [*restart, *hardening]
+    build:
+      context: ./services/bff-nestjs
+      dockerfile: ../../docker/Dockerfile.node20
+    depends_on:
+      redis:
+        condition: service_healthy
+      core-springboot:
+        condition: service_started
+    environment:
+      NODE_ENV: "production"
+      PORT: "3000"
+      CORE_BASE_URL: "http://core-springboot:8080"
+      REDIS_HOST: "redis"
+      REDIS_PORT: "6379"
+      REDIS_PASSWORD: "${REDIS_PASSWORD:-Redis#Cache2026}"
+      JWT_SECRET: "${JWT_SECRET:-cambia-este-secreto-por-uno-de-al-menos-32-caracteres-aleatorios}"
+      OTEL_SERVICE_NAME: "bff-nestjs"
+      OTEL_EXPORTER_OTLP_ENDPOINT: "http://otel-collector:4317"
+    ports:
+      - "3000:3000"
+    networks: [banking-net]
+
+  audit-fastapi:
+    <<: [*restart, *hardening]
+    build:
+      context: ./services/audit-fastapi
+      dockerfile: ../../docker/Dockerfile.python312
+    depends_on:
+      postgres:
+        condition: service_healthy
+      rabbitmq:
+        condition: service_healthy
+    environment:
+      PORT: "8000"
+      DATABASE_URL: "postgresql://${POSTGRES_USER:-audit_user}:${POSTGRES_PASSWORD:-Audit#Pg2026}@postgres:5432/${POSTGRES_DB:-audit_db}"
+      RABBITMQ_URL: "amqp://${RABBITMQ_DEFAULT_USER:-banking}:${RABBITMQ_DEFAULT_PASS:-Rabbit#Bus2026}@rabbitmq:5672/"
+      OTEL_SERVICE_NAME: "audit-fastapi"
+      OTEL_EXPORTER_OTLP_ENDPOINT: "http://otel-collector:4317"
+    expose: ["8000"]
+    networks: [banking-net]
+
+  nginx:
+    <<: *restart
+    image: nginx:1.27-alpine
+    read_only: true
+    tmpfs:
+      - /tmp:rw,nosuid,size=64m
+      - /var/cache/nginx:rw,nosuid,size=32m
+    security_opt: ["no-new-privileges:true"]
+    ports:
+      - "8088:80"
+    volumes:
+      - ./gateway-nginx/nginx.conf:/etc/nginx/nginx.conf:ro
+    networks: [banking-net]
+
+  # ----------------------------------------- Observabilidad (heredada: ./monitoring) ----
+  otel-collector:
+    <<: *restart
+    image: otel/opentelemetry-collector-contrib:0.108.0
+    command: ["--config=/etc/otelcol/${OTEL_COLLECTOR_CONFIG_FILE:-otel-collector-config.yaml}"]
+    volumes:
+      - ./monitoring:/etc/otelcol:ro
+    expose: ["4317", "4318", "8889"]
+    networks: [banking-net]
+
+  prometheus:
+    <<: *restart
+    image: prom/prometheus:v2.54.1
+    command:
+      - "--config.file=/etc/prometheus-cfg/${PROMETHEUS_CONFIG_FILE:-prometheus.banking.yml}"
+      - "--storage.tsdb.path=/prometheus"
+      - "--web.enable-lifecycle"
+    volumes:
+      - ./monitoring:/etc/prometheus-cfg:ro
+      - prom-data:/prometheus
+    ports:
+      - "9090:9090"
+    networks: [banking-net]
+
+  grafana:
+    <<: *restart
+    image: grafana/grafana:11.2.0
+    environment:
+      GF_SECURITY_ADMIN_USER: "admin"
+      GF_SECURITY_ADMIN_PASSWORD: "${GRAFANA_ADMIN_PASSWORD:-Grafana#Obs2026}"
+      GF_USERS_ALLOW_SIGN_UP: "false"
+    volumes:
+      - ./monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
+      - ./monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
+      - grafana-data:/var/lib/grafana
+    ports:
+      - "3001:3000"
+    depends_on:
+      - prometheus
+    networks: [banking-net]
+
+networks:
+  banking-net:
+    driver: bridge
+
+volumes:
+  mssql-data:
+  pg-data:
+  redis-data:
+  rabbit-data:
+  prom-data:
+  grafana-data:
