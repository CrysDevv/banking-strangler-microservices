diff --git a/gateway-nginx/nginx.conf b/gateway-nginx/nginx.conf
new file mode 100644
index 0000000..95eb67b
--- /dev/null
+++ b/gateway-nginx/nginx.conf
@@ -0,0 +1,51 @@
+# Gateway minimo de Fase 1: arranca aunque los upstreams aun no existan
+# (resolucion DNS diferida con variable + resolver de Docker).
+# La Fase 4 lo reemplaza con rate limiting, cabeceras de seguridad y rutas completas.
+worker_processes auto;
+pid /tmp/nginx.pid;
+
+events { worker_connections 1024; }
+
+http {
+    include       /etc/nginx/mime.types;
+    default_type  application/octet-stream;
+    access_log    /dev/stdout;
+    error_log     /dev/stderr warn;
+
+    client_body_temp_path /tmp/client_temp;
+    proxy_temp_path       /tmp/proxy_temp;
+    fastcgi_temp_path     /tmp/fastcgi_temp;
+    uwsgi_temp_path       /tmp/uwsgi_temp;
+    scgi_temp_path        /tmp/scgi_temp;
+
+    resolver 127.0.0.11 valid=10s ipv6=off;
+
+    # Propaga X-Correlation-ID o lo genera si el cliente no lo envia
+    map $http_x_correlation_id $correlation_id {
+        default $http_x_correlation_id;
+        ""      $request_id;
+    }
+
+    server {
+        listen 80;
+        server_tokens off;
+
+        add_header X-Correlation-ID $correlation_id always;
+
+        location = /healthz {
+            default_type text/plain;
+            return 200 "ok\n";
+        }
+
+        location /api/ {
+            set $bff http://bff-nestjs:3000;
+            proxy_pass $bff;
+            proxy_http_version 1.1;
+            proxy_set_header Host              $host;
+            proxy_set_header X-Real-IP         $remote_addr;
+            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
+            proxy_set_header X-Forwarded-Proto $scheme;
+            proxy_set_header X-Correlation-ID   $correlation_id;
+        }
+    }
+}
